{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Jarvis",
  "version": "0.1.2",
  "identifier": "dev.lopadova.jarvis",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:*",
        "img-src": "'self' data: asset: http://asset.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Voice-first personal assistant",
    "longDescription": "Jarvis is a voice-first assistant that answers quick questions and hands real work to background agents, asking before anything risky.",
    "copyright": "Copyright (c) Jarvis Desktop contributors (MIT)",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/agent-host"],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["jarvis"] }
    },
    "updater": {
      "pubkey": "REPLACE_WITH_MINISIGN_PUBLIC_KEY (see apps/desktop/README.md#updater)",
      "endpoints": ["https://github.com/lopadova/jarvis-desktop/releases/latest/download/latest.json"]
    }
  }
}
