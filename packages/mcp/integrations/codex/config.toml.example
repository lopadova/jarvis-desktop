# Jarvis for Codex — add this to ~/.codex/config.toml
# The Jarvis desktop app must be running; the server only talks to it over loopback.

[mcp_servers.jarvis]
command = "jarvis-mcp"          # installed with `npm i -g @jarvis/mcp`
args = []
# jarvis_ask_user waits for a spoken answer for up to 10 minutes.
startup_timeout_sec = 20
tool_timeout_sec = 620

# Without a global install:
# command = "npx"
# args = ["-y", "@jarvis/mcp"]
#
# With a local build of this repository:
# command = "node"
# args = ["/absolute/path/to/jarvis-desktop/packages/mcp/dist/jarvis-mcp.mjs"]
#
# Custom data directory (only if you set one for the app):
# env = { JARVIS_DATA_DIR = "/path/to/Jarvis" }
