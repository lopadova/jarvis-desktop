{
  "name": "@jarvis/agent-host",
  "version": "0.1.4",
  "description": "Jarvis sidecar: loopback JSON-RPC server, turn orchestrator, sessions, agent drivers, approvals, voice pipeline, reminders, MCP and relay link.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "say": "bun run src/cli.ts say",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:binary": "node scripts/build-binary.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.306",
    "@jarvis/core": "workspace:*",
    "@jarvis/providers": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openai/codex-sdk": "^0.163.0",
    "ipaddr.js": "^2.5.0",
    "tldts": "^7.4.19",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2"
  }
}
